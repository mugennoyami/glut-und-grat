# Vorlage – nach .env.local kopieren. Geheimnisse niemals committen.
# Ohne diese Werte läuft die Website vollständig als Demo.

# Öffentliche Basis-URL (Metadaten, Sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Öffentliche Kontaktadresse (leer = "noch festzulegen" auf der Seite)
NEXT_PUBLIC_CONTACT_EMAIL=

# Suchmaschinen erst nach der Live-Schaltung erlauben
SITE_INDEXABLE=false

# Zustellung von Formularanfragen (leer = es wird nichts gesendet, die Seite sagt das ehrlich)
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# Zahlungsanbieter ("demo" = keine Bestellung, keine Zahlung)
PAYMENT_PROVIDER=demo
# Nur serverseitig; leer = Zahlungs-Webhook ist abgeschaltet
PAYMENT_WEBHOOK_SECRET=
